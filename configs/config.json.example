{
    "REQUIRED_API_KEY": "123456",
    "SERVER_PORT": 3000,
    "HOST": "0.0.0.0",
    "MODEL_PROVIDER": "gemini-cli-oauth",
    "SYSTEM_PROMPT_FILE_PATH": "configs/input_system_prompt.txt",
    "SYSTEM_PROMPT_MODE": "overwrite",
    "SYSTEM_PROMPT_REPLACEMENTS": [
        { "old": "Old text to replace", "new": "New replacement text" },
        { "old": "AI", "new": "Smart Bot" }
    ],
    "PROMPT_LOG_BASE_NAME": "prompt_log",
    "PROMPT_LOG_MODE": "none",
    "REQUEST_MAX_RETRIES": 3,
    "REQUEST_BASE_DELAY": 1000,
    "API_POTLUCK_PERSIST_INTERVAL": 30000,
    "API_POTLUCK_MAX_DIRTY_AGE": 60000,
    "API_POTLUCK_DEFAULT_DAILY_LIMIT": 500,
    "MODEL_USAGE_STATS_PERSIST_DEBOUNCE_MS": 30000,
    "USAGE_EVENT_BATCH_SIZE": 100,
    "USAGE_EVENT_BATCH_WAIT_MS": 1000,
    "USAGE_EVENT_RETENTION_DAYS": 45,
    "USAGE_HOURLY_RETENTION_DAYS": 90,
    "USAGE_DAILY_RETENTION_DAYS": 400,
    "USAGE_SQLITE_WAL_CHECKPOINT_BYTES": 67108864,
    "RUNTIME_HOOK_SPOOL_MAX_BYTES": 268435456,
    "MODEL_USAGE_STATS_MAX_DIRTY_AGE_MS": 60000,
    "REQUEST_BODY_MAX_BYTES": 104857600,
    "RATE_LIMIT_COOLDOWN_ENABLED": false,
    "RATE_LIMIT_COOLDOWN_MS": 30000,
    "RATE_LIMIT_COOLDOWN_JITTER_MS": 5000,
    "RATE_LIMIT_COOLDOWN_MAX_MS": 300000,
    "CODEX_POTLUCK_STICKY_PROVIDER_ENABLED": false,
    "CODEX_PREWARM_ENABLED": true,
    "CODEX_PREWARM_TIMES": ["06:30", "11:30"],
    "CODEX_PREWARM_ATTEMPTS": 2,
    "CODEX_PREWARM_TIMEZONE": "Asia/Shanghai",
    "CODEX_PREWARM_DUE_WINDOW_MS": 600000,
    "CODEX_PREWARM_POLL_INTERVAL_MS": 60000,
    "CODEX_PREWARM_STATE_FILE": "configs/codex-prewarm-state.json",
    "CODEX_PREWARM_MODEL": "gpt-5-codex-mini",
    "CRON_NEAR_MINUTES": 1,
    "CRON_REFRESH_TOKEN": false,
    "PROVIDER_POOLS_FILE_PATH": "configs/provider_pools.json",
    "CUSTOM_MODELS_FILE_PATH": "configs/custom_models.json",
    "MAX_ERROR_COUNT": 3,
    "GROK_COOKIE_TOKEN": "your-sso-cookie-token",
    "GROK_CF_CLEARANCE": "your-cf-clearance-cookie",
    "GROK_USER_AGENT": "Mozilla/5.0 ...",
    "GROK_BASE_URL": "https://grok.com",
    "antigravityElasticRouting": {
      "enabled": false,
      "_comment": "Antigravity 弹性路由：默认关闭，请求严格按原模型执行，不再静默降级到链上其他模型。确需配额耗尽时自动降级，显式把 enabled 改为 true；fallbackModels 为空时使用内置链 gemini-2.5-flash-lite → gemini-3.1-flash-lite → gemini-2.5-flash → gemini-3.5-flash-lite → gemini-3-flash。",
      "fallbackModels": [],
      "maxQueueWaitMs": 30000,
      "preferOriginalWaitMs": 5000
    },
    "providerFallbackChain": {
      "gemini-cli-oauth": ["gemini-antigravity"],
      "gemini-antigravity": ["gemini-cli-oauth"],
      "claude-kiro-oauth": ["claude-custom"],
      "claude-custom": ["claude-kiro-oauth"]
    },
    "mixedProviderPools": {
      "gpt": {
        "enabled": false,
        "matchModels": ["gpt-*"],
        "entryProviders": ["openai-codex-oauth"],
        "candidateProviders": ["openai-codex-oauth", "openaiResponses-custom"]
      }
    },
    "modelFallbackMapping": {
      "gemini-claude-opus-4-5-thinking": {
        "targetProviderType": "claude-kiro-oauth",
        "targetModel": "claude-opus-4-5"
      },
      "gemini-claude-sonnet-4-5-thinking": {
        "targetProviderType": "claude-kiro-oauth", 
        "targetModel": "claude-sonnet-4-5"
      },
      "gemini-claude-sonnet-4-5": {
        "targetProviderType": "claude-kiro-oauth",
        "targetModel": "claude-sonnet-4-5"
      },
      "claude-opus-4-5": {
        "targetProviderType": "gemini-antigravity",
        "targetModel": "gemini-claude-opus-4-5-thinking"
      },
      "claude-sonnet-4-5": {
        "targetProviderType": "gemini-antigravity",
        "targetModel": "gemini-claude-sonnet-4-5"
      },
      "gpt-5.4": { "targetProviderType": "openai-codex-oauth", "targetModel": "gpt-6-luna" },
      "gpt-5.4-fast": { "targetProviderType": "openai-codex-oauth", "targetModel": "gpt-6-luna" },
      "gpt-5.4-mini": { "targetProviderType": "openai-codex-oauth", "targetModel": "gpt-6-luna" },
      "gpt-5.4-mini-fast": { "targetProviderType": "openai-codex-oauth", "targetModel": "gpt-6-luna" }
    },
    "workdayCalendars": {
      "cn-statutory-workday": {
        "timezone": "Asia/Shanghai",
        "years": {
          "2026": {
            "holidays": [
              "2026-01-01", "2026-01-02", "2026-01-03",
              "2026-02-15", "2026-02-16", "2026-02-17", "2026-02-18", "2026-02-19",
              "2026-02-20", "2026-02-21", "2026-02-22", "2026-02-23",
              "2026-04-04", "2026-04-05", "2026-04-06",
              "2026-05-01", "2026-05-02", "2026-05-03", "2026-05-04", "2026-05-05",
              "2026-06-19", "2026-06-20", "2026-06-21",
              "2026-09-25", "2026-09-26", "2026-09-27",
              "2026-10-01", "2026-10-02", "2026-10-03", "2026-10-04",
              "2026-10-05", "2026-10-06", "2026-10-07"
            ],
            "makeupWorkdays": [
              "2026-01-04", "2026-02-14", "2026-02-28",
              "2026-05-09", "2026-09-20", "2026-10-10"
            ]
          }
        }
      }
    },
    "temporaryKeyModelRoutes": [
      {
        "id": "temporary-antigravity-flash",
        "enabled": false,
        "keyHash": "sha256:<full-64-character-hex-digest>",
        "paths": ["/openai-codex-oauth/v1/responses"],
        "modelFamilies": ["gpt-5.3", "gpt-5.4"],
        "targetProviderType": "gemini-antigravity",
        "targetModel": "gemini-2.5-flash",
        "fallbackModel": "gpt-6-luna",
        "fallbackToOriginal": true,
        "preserveResponseModel": true,
        "targetBlackout": {
          "timezone": "Asia/Shanghai",
          "calendar": "cn-statutory-workday",
          "start": "05:00",
          "end": "19:00",
          "modelFamilies": ["gpt-5.4", "gpt-5.3-codex-spark"],
          "fallbackProviderType": "openai-codex-oauth",
          "fallbackModel": "gpt-6-luna"
        }
      }
    ],
    "PROXY_URL": "http://127.0.0.1:1089",
    "PROXY_ENABLED_PROVIDERS": [
            "gemini-cli-oauth",
            "gemini-antigravity"
    ],
    "LOG_ENABLED": true,
    "LOG_OUTPUT_MODE": "all",
    "LOG_LEVEL": "info",
    "LOG_DIR": "logs",
    "CODEX_RETRY_AUDIT_ENABLED": true,
    "CODEX_RETRY_AUDIT_DIR": "configs/retry-audit",
    "CODEX_RETRY_AUDIT_MAX_FILE_SIZE": 26214400,
    "CODEX_RETRY_AUDIT_MAX_FILES": 7,
    "CODEX_RETRY_AUDIT_RETENTION_DAYS": 7,
    "LOG_INCLUDE_REQUEST_ID": true,
    "REQUEST_PERF_SAMPLE_RATE": 0,
    "REQUEST_PERF_SLOW_MS": 0,
    "LOG_INCLUDE_TIMESTAMP": true,
    "LOG_MAX_FILE_SIZE": 10485760,
    "LOG_MAX_FILES": 10,
    "LOG_RETENTION_DAYS": 7,
    "TLS_SIDECAR_ENABLED": false,
    "TLS_SIDECAR_PORT": 9090,
    "UI_ENABLED": true
}
